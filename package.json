{
  "name": "ui-workspace",
  "private": true,
  "description": "Workspace for @hussmartinez/ui and its catalogue.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "changeset": "changeset",
    "lint": "biome check .",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input",
    "lint:deps": "hm-lint-deps packages",
    "check:single-copy": "hm-check-single-copy",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test && pnpm test:repo",
    "test:repo": "vitest run",
    "test:browser": "pnpm -r --if-present test:browser",
    "test:visual": "node scripts/test-visual.mjs",
    "test:visual:update": "node scripts/test-visual.mjs --update",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "check:size": "pnpm -r --if-present check:size",
    "check:api": "pnpm -r --if-present check:api",
    "check:package": "pnpm -r --if-present check:package",
    "verify": "pnpm lint && pnpm lint:css && pnpm typecheck && pnpm lint:deps && pnpm check:single-copy && pnpm build && pnpm test && pnpm test:browser && pnpm test:visual && pnpm test:e2e && pnpm check:size && pnpm check:api && pnpm check:package",
    "verify:fast": "pnpm typecheck && pnpm test && pnpm lint:deps && pnpm check:single-copy && pnpm check:api"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@hussmartinez/sdk-config": "catalog:",
    "dependency-cruiser": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "secretlint": "catalog:",
    "stylelint": "catalog:",
    "vitest": "catalog:"
  }
}
